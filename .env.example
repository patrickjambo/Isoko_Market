# Isoko Market — environment template. Copy to `.env` and fill in.
# All secrets are provided by the host/CI — never commit real values (Section 14).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/isoko?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -hex 32"
CRON_SECRET="generate-with: openssl rand -hex 32"   # for /api/cron/sweep (Vercel Cron)

SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID="ISOKO"

PAYMENTS_PROVIDER="mock"
# Shared secret the provider callback must present (header) before we trust a
# webhook body. Falls back to AUTH_SECRET if unset. Replaced/augmented by real
# MTN/Airtel HMAC signature verification once a live provider is wired.
PAYMENTS_WEBHOOK_SECRET="generate-with: openssl rand -hex 32"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""

STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET="isoko"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

REALTIME_DRIVER="sse"
