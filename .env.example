# Isoko Market — environment template. Copy to `.env` and fill in.
# All secrets are provided by the host/CI — never commit real values (Section 14).

# On Neon: DATABASE_URL = the POOLED string (host contains "-pooler"), used by the
# app; DIRECT_URL = the UNPOOLED string (host without "-pooler"), used by migrations.
# Locally both point at the same database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/isoko?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/isoko?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -hex 32"
CRON_SECRET="generate-with: openssl rand -hex 32"   # for /api/cron/sweep (Vercel Cron)

# Email delivery — the login-OTP + notification channel (Section 10).
#   console → log codes to the server console (dev).
#   resend  → real email, but shared onboarding@resend.dev only reaches the
#             Resend account owner until you verify a domain (resend.com/domains).
#   brevo   → real email to ANY recipient after verifying a single sender address
#             (Brevo dashboard → Senders) — no domain purchase required. 300/day free.
# Set EMAIL_FROM to your verified sender, e.g. "Isoko Market <you@example.com>".
EMAIL_PROVIDER="console"        # console | resend | brevo
RESEND_API_KEY=""               # re_...       (from resend.com)
BREVO_API_KEY=""                # xkeysib-...  (from app.brevo.com → SMTP & API → API Keys)
EMAIL_FROM="Isoko Market <onboarding@resend.dev>"

# AI assist (Claude) — optional. With a key, "Suggest description" writes a real
# draft in the seller's language; without it, the rule-based drafter is used, so
# the feature always works. AI_MODEL: claude-opus-4-8 (default) is the most
# capable; claude-haiku-4-5 is much cheaper/faster for short drafts.
ANTHROPIC_API_KEY=""            # sk-ant-...   (from platform.claude.com)
AI_MODEL="claude-opus-4-8"      # claude-opus-4-8 | claude-haiku-4-5 | claude-sonnet-4-6

# SMS — DORMANT (auth moved to email OTP). Retained for future use.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID="ISOKO"

# Payments — DORMANT for buyer↔seller product payments (now manual peer-to-peer;
# money moves off-platform, both sides confirm in-app). Retained for platform
# fees / a future real merchant-API or escrow model.
# 'auto' picks a real provider from whichever keys below are filled in (MTN &/or
# Airtel by the payer's carrier, else CentriPay, else the dev mock). Paste keys +
# set PAYMENTS_ENV=production and redeploy — no code changes needed.
PAYMENTS_PROVIDER="auto"        # auto | mock | mtn_momo | airtel_money | centripay
PAYMENTS_ENV="sandbox"          # sandbox | production
# Shared secret the provider callback must present (header) before we trust a
# webhook body. Falls back to AUTH_SECRET if unset.
PAYMENTS_WEBHOOK_SECRET="generate-with: openssl rand -hex 32"

# MTN MoMo — Collections (charge buyer). Production: set the market base URL,
# MTN_MOMO_TARGET_ENV="mtnrwanda", MTN_MOMO_CURRENCY="RWF".
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_TARGET_ENV="sandbox"
MTN_MOMO_CURRENCY="EUR"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
# MTN Disbursements (pay seller's phone) — optional; blank = manual payout leg.
MTN_DISBURSE_SUBSCRIPTION_KEY=""
MTN_DISBURSE_API_USER=""
MTN_DISBURSE_API_KEY=""

# Airtel Money — production base is https://openapi.airtel.africa
AIRTEL_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
AIRTEL_COUNTRY="RW"
AIRTEL_CURRENCY="RWF"
AIRTEL_PIN=""                   # encrypted PIN, disbursements only

# CentriPay — free fallback aggregator (used when no MTN/Airtel keys are set)
CENTRIPAY_BASE_URL=""
CENTRIPAY_API_KEY=""

# File storage. local = /public/uploads (dev only; no persistent disk on
# serverless). vercel_blob = Vercel Blob (recommended on Vercel). r2/s3 reserved.
STORAGE_DRIVER="local"          # local | vercel_blob | r2 | s3
# Provided automatically by Vercel once you enable Blob (Storage tab). Only set
# it by hand to test the blob driver locally.
BLOB_READ_WRITE_TOKEN=""
S3_ENDPOINT=""
S3_BUCKET="isoko"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

REALTIME_DRIVER="sse"
