# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# local database cluster (self-contained dev Postgres)
/.pgdata

# uploads (dev local file storage — prod uses S3/R2)
/public/uploads/*
!/public/uploads/.gitkeep

# env
.env
.env*.local

# misc
.DS_Store
*.pem
/coverage
.vscode/*
!.vscode/extensions.json

# editor atomic-write leftovers
*.tmp.*

# claude code — keep shared settings, ignore personal/local ones
.claude/settings.local.json

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
